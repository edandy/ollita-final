# Cliente (Vite — visible en el browser; nunca pongas service_role aquí)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Servidor (mismas URL/anon key + service_role)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DigitalOcean Spaces (solo servidor — nunca uses prefijo VITE_)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=la-ollita
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# Opcional. Si está definido, las URLs públicas salen de aquí.
# Ejemplo: https://la-ollita.sfo3.cdn.digitaloceanspaces.com
SPACES_CDN_URL=

# WhatsApp Cloud API (solo servidor — reset de PIN)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PIN_TEMPLATE=pin_reset
WHATSAPP_PIN_TEMPLATE_LANG=es
